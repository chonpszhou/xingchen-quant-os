# =====================================================
# 星辰投研团 · 凭证模板
# 复制本文件为 .env 并填入真实值（.env 不提交版本库）
#   cp .env.example .env
# 填写后运行: python3 scripts/check_connections.py 复检
# =====================================================

# ---- 可选增强数据源（公开接口无需密钥，以下为可选）----
TUSHARE_TOKEN=

# ---- 邮件推送 (SMTP) ----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_TO=            # 多个收件人用英文逗号分隔

# ---- IM 机器人 Webhook（任选其一或全部）----
FEISHU_WEBHOOK=
DINGTALK_WEBHOOK=
WECOM_WEBHOOK=
SERVERCHAN_KEY=
PUSHPLUS_TOKEN=
